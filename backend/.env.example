################################################################################
# ⚠️ PENGUMUMAN KEAMANAN (SECURITY WARNING) - BACA SEBELUM MULAI!
# -----------------------------------------------------------------------------
# DILARANG KERAS MENGISI FILE INI ATAUPUN FILE .env DENGAN KUNCI ASLI (PRODUCTION)!
# Kunci asli/produksi hanya dimasukkan oleh Super Admin melalui Vercel Dashboard.
# Bagi Developer, SILAKAN GUNAKAN KUNCI MAINAN (DUMMY) atau akun gratisan Anda sendiri
# untuk melakukan pengetesan sistem di localhost.
#
# HARAP RUJUK KE DOKUMEN SOP_KEAMANAN_AGENCY.md
################################################################################

# TIDB CLOUD DATABASE (Gunakan database lokal/xampp/sandbox)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="dummy_test_db"
DB_USERNAME="root"
DB_PASSWORD=""

# ONESIGNAL (Gunakan app ID mainan Anda sendiri)
ONESIGNAL_APP_ID="dummy_app_id"
ONESIGNAL_REST_API_KEY="dummy_rest_key"

# CLOUDINARY (Gunakan akun cloudinary gratisan Anda)
CLOUDINARY_CLOUD_NAME="dummy_cloud"
CLOUDINARY_API_KEY="dummy_key"
CLOUDINARY_API_SECRET="dummy_secret"
CLOUDINARY_URL="cloudinary://dummy:dummy@dummy"

# BREVO (Gunakan API Key mainan Anda sendiri)
BREVO_API_KEY="dummy_brevo_key"

# GEMINI (GOOGLE GENERATIVE AI)
GEMINI_API_KEY="dummy_gemini_key"

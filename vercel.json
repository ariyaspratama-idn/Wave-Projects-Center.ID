{
    "functions": {
        "backend/api/index.php": {
            "runtime": "vercel-php@0.6.1"
        }
    },
    "rewrites": [
        {
            "source": "/api/v1/(.*)",
            "destination": "/backend/api/index.php"
        },
        {
            "source": "/backend/(.*)",
            "destination": "/backend/api/index.php"
        }
    ]
}